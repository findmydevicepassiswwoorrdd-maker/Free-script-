local function clampToScreen()
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize
    if not vp or vp.X <= 0 or vp.Y <= 0 then return end

    local ap = root.AbsolutePosition
    local sz = root.AbsoluteSize
    if sz.X <= 0 or sz.Y <= 0 then return end

    local x = math.clamp(ap.X, 0, math.max(0, vp.X - sz.X))
    local y = math.clamp(ap.Y, 0, math.max(0, vp.Y - sz.Y))

    if math.abs(x - ap.X) > 0.5 or math.abs(y - ap.Y) > 0.5 then
        root.Position = UDim2.fromOffset(x, y)
    end
end

local function clampNextFrame()
    task.spawn(function()
        task.wait()
        pcall(clampToScreen)
    end)
end

local dragMove, dragEnd

local function stopDrag()
    if not panel.dragging then return end
    panel.dragging = false
    if dragMove then pcall(function() dragMove:Disconnect() end); dragMove = nil end
    if dragEnd  then pcall(function() dragEnd:Disconnect()  end); dragEnd  = nil end
    pcall(clampToScreen)
end

local function beginDrag(input)
    stopDrag()

    local startPos   = root.Position
    local startInput = input.Position
    local isMouse    = (input.UserInputType == Enum.UserInputType.MouseButton1)

    panel.dragging = true

    dragMove = UserInputService.InputChanged:Connect(function(move)
        if not panel.dragging or not move then return end
        local mt = move.UserInputType
        if mt ~= Enum.UserInputType.MouseMovement and mt ~= Enum.UserInputType.Touch then
            return
        end
        local d = move.Position - startInput
        root.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end)

    dragEnd = UserInputService.InputEnded:Connect(function(e)
        if not panel.dragging or not e then return end
        if e.UserInputType == input.UserInputType then
            stopDrag()
        end
    end)

    -- desktop safety: button released without an End event ever arriving
    if isMouse then
        task.spawn(function()
            while panel.dragging do
                task.wait(0.05)
                local ok, down = pcall(function()
                    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                end)
                if ok and not down then
                    stopDrag()
                    break
                end
            end
        end)
    end
end

bar.InputBegan:Connect(function(input)
    if not input then return end
    local t = input.UserInputType
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        beginDrag(input)
    end
end)

local function setMinimized(min)
    panel.minimized = (min == true)
    local bodyFrame = root:FindFirstChild("Body")

    if panel.minimized then
        panel.fullH = root.Size.Y.Offset
        if bodyFrame then bodyFrame.Visible = false end
        root.Size = UDim2.fromOffset(PANEL_W, TITLE_H)
        minBtn.Text = "+"
        title.Text = (panel.summary ~= "" and panel.summary) or panel.baseTitle
    else
        root.Size = UDim2.fromOffset(PANEL_W, panel.fullH > 0 and panel.fullH or PANEL_H)
        if bodyFrame then bodyFrame.Visible = true end
        minBtn.Text = "-"
        title.Text = panel.baseTitle
    end

    clampNextFrame()
end

