    scanInterval     = 0.3,    -- how often to look for new balloons
    popDelay         = 0.12,   -- wait after landing on a balloon
    returnAfterPop   = true,   -- put you back where you were after each pop
    includeLobbyDecor = false, -- also pop red "Balloon" decor in the lobby
    keybind          = Enum.KeyCode.RightShift,
    target           = 99,
}

