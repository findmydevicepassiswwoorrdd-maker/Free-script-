local RUN = { running = false, popped = 0, status = "idle", seen = {} }

------------------------------------------------------------------------------
-- character
------------------------------------------------------------------------------

local function getChar()
    local char = lp.Character
    if not char or not char.Parent then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 then
        return char, hum, hrp
    end
    return nil
end

------------------------------------------------------------------------------
-- balloon discovery
------------------------------------------------------------------------------

local function isRed(part)
    local c = part.Color
    return c.R > 0.35 and c.G < 0.25 and c.B < 0.25
end

local function isCandidate(part)
    if not part or not part.Parent then return false end
    if not part:IsA("BasePart") then return false end
    if RUN.seen[part] then return false end
    if part:GetAttribute("Popped") == true then return false end

    local tags = CollectionService:GetTags(part)
    local redTag = false
    local plainTag = false
    for _, t in ipairs(tags) do
        if t == "BalloonRed" then redTag = true end
        if t == "Balloon" then plainTag = true end
    end

    if redTag then return true end
    if plainTag and CONFIG.includeLobbyDecor and isRed(part) then return true end
    return false
end

local function findBalloons()
    local found = {}
    for _, part in ipairs(CollectionService:GetTagged("BalloonRed")) do
        if isCandidate(part) then
            table.insert(found, part)
        end
    end
    if CONFIG.includeLobbyDecor then
        for _, part in ipairs(CollectionService:GetTagged("Balloon")) do
            if isCandidate(part) then
                table.insert(found, part)
            end
        end
    end
    return found
end

------------------------------------------------------------------------------
-- popping
------------------------------------------------------------------------------

local function pop(part)
    local _, _, hrp = getChar()
    if not hrp then return false, "no character" end

    local target = part.Position
    local back = CONFIG.returnAfterPop and hrp.CFrame or nil

    -- land on it
    for _ = 1, 3 do
        if not hrp.Parent then break end
        hrp.CFrame = CFrame.new(target)
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait()
    end

    task.wait(CONFIG.popDelay)

    -- the game sets "Popped" locally the moment its Touched fires, so this
    -- confirms the touch actually landed rather than just assuming it did
    local landed = part:GetAttribute("Popped") == true

    if not landed then
        -- one more nudge, some balloons drift on the server between frames
        if hrp.Parent and part.Parent then
            hrp.CFrame = CFrame.new(part.Position)
            task.wait(0.2)
            landed = part:GetAttribute("Popped") == true
        end
    end

    if back and hrp.Parent then
        hrp.CFrame = back
    end

    RUN.seen[part] = true
    if landed then
        RUN.popped = RUN.popped + 1
    end
    return landed
end

------------------------------------------------------------------------------
-- optional: read real quest progress from the server
------------------------------------------------------------------------------

local function readProgress()
    local ok, Network = pcall(function()
        return require(game:GetService("ReplicatedStorage"):WaitForChild("Load"))("Network")
    end)
    if not ok or not Network then return nil end

    local ok2, quests = pcall(function()
        return Network:InvokeServer("GetDirewickFestivalQuests")
    end)
    if not ok2 or type(quests) ~= "table" then return nil end

    local q = quests["99_red_balloons_2026"]
    if type(q) ~= "table" then return nil end
    return q.Progress, q.Completed
end

------------------------------------------------------------------------------
-- main loop
------------------------------------------------------------------------------

local ui = { refresh = function() end }

task.spawn(function()
    while true do
        task.wait(CONFIG.scanInterval)

        if RUN.running then
            local list = findBalloons()
            if #list > 0 then
                local part = list[1]
                RUN.status = "popping"
                local ok, err = pop(part)
                RUN.status = ok and "popped one" or ("miss: " .. tostring(err))
                ui.refresh()
            else
                RUN.status = "no red balloons here"
                ui.refresh()
            end
        end
    end
end)

