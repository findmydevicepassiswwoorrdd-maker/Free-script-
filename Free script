end

local function refreshProgress()
    local prog, done = readProgress()
    if prog then
        local shown = math.min(prog, CONFIG.target)
        big.Text = ("%d / %d"):format(shown, CONFIG.target)
        big.TextColor3 = done and COL.good or COL.red
        subLabel.Text = done and "quest complete" or "server progress"
        panel.setSummary(done and "Balloons - complete" or ("Balloons %d/%d"):format(shown, CONFIG.target))
    else
        big.Text = "-- / " .. CONFIG.target
        subLabel.Text = "progress unavailable"
        panel.setSummary("Balloons --/" .. CONFIG.target)
    end
end

